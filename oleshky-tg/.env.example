# Скопіюй у .env (поруч з цим файлом) і заповни.
# ВАЖЛИВО: робочий TG-акаунт має бути окремий, не особистий.

# Telegram API (https://my.telegram.org → API development tools)
TG_API_ID_1=
TG_API_HASH_1=
# шлях до файлу сесії (відносно oleshky-tg/), розширення .session додасть Telethon
TG_SESSION_1=data/sessions/oleshky_1

# Другий акаунт — опційно; на нього перемикаємось при FloodWait > 300 с
TG_API_ID_2=
TG_API_HASH_2=
TG_SESSION_2=data/sessions/oleshky_2

# Локальний LLM (за замовчуванням)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# OpenAI — тільки з прапорцем --llm openai (тексти постів підуть у хмару!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Сіль для хешування авторів у групах. Згенеруй один раз і не змінюй:
#   python -c "import secrets; print(secrets.token_hex(32))"
SENDER_HASH_SALT=
